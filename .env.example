# Never publish real secrets or commit your .env file.
BOT_TOKEN=PUT_TELEGRAM_BOT_TOKEN_HERE
GEMINI_API_KEY=PUT_GOOGLE_AI_STUDIO_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
WEBHOOK_SECRET=replace-with-a-long-random-secret
MAX_IMAGE_MB=10
USER_COOLDOWN_SECONDS=15
MAX_DAILY_USER_REQUESTS=30
# Optional comma-separated Telegram numeric user IDs; these users bypass daily limit.
ADMIN_USER_IDS=
LOG_LEVEL=INFO
